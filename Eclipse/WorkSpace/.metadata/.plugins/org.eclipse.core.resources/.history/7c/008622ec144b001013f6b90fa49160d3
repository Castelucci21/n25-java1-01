package br.com.senaisp.com.Aula05;

import java.util.Scanner;

public class Exemplo05 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		System.out.println("Digite um valor entre 1 a 5");
		int vlr = sc.nextInt();
		switch (vlr) {
		case 1: System.out.println("Você ganhou uma caneta!");
		case 2: System.out.println("Você ganhou um lápis!"); 
		case 3: System.out.println("Você ganhou um borracha!"); 
		case 4: System.out.println("Você ganhou um bombom!"); 
		case 5: System.out.println("Você ganhou um bala!"); 
		}
		sc.close();
	}

}
