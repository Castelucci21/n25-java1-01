package br.com.senaisp.com.Aula05;

import java.util.Scanner;

public class Exemplo03 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		System.out.println("Digite sua data de nascimento: ");
		String dtNasc = sc.nextLine();
		//criando um scanner de apoio
		Scanner sc2 = new Scanner(dtNasc) //passando o texto para ela
		sc2.useDelimiter("/");//Mudando o delimitador padrão, de espaço para Barra
		int dia = sc2.nextInt();
		int mês = sc2.nextInt();
		int ano = sc2.nextInt();
		System.out.println("Você tem " + (2025 - ano) + "anos");
		sc.close();
		sc2.close();
	}

}
